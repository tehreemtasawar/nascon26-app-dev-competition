# Copy this file to .env for local use. Never commit the real .env.
# The grader supplies the real salt: DAY1_SALT=<salt> docker compose up -d --build
DAY1_SALT=replace-me-locally-only

# Teammates: add every variable your services need below.
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_dev_password
POSTGRES_DB=nascon
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-me-locally-only
